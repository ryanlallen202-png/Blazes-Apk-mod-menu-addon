name: Build dark-matter

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Install NDK r27c
        run: |
          wget -q https://dl.google.com/android/repository/android-ndk-r27c-linux.zip
          unzip -q android-ndk-r27c-linux.zip
          echo "ANDROID_NDK=$PWD/android-ndk-r27c" >> $GITHUB_ENV

      - name: Install CMake + Ninja
        run: sudo apt-get install -y cmake ninja-build

      - name: Build
        run: |
          chmod +x build.sh
          ./build.sh

      - name: Upload dark-matter.so
        uses: actions/upload-artifact@v4
        with:
          name: dark-matter
          path: out/dark-matter.so
